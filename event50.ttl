:адрес a owl:DatatypeProperty ;
    rdfs:domain :Локация ;
    rdfs:range xsd:string .

:действуетНа a owl:ObjectProperty ;
    owl:inverseOf :имеетСкидку .

:длительность a owl:DatatypeProperty ;
    rdfs:domain :Мероприятие ;
    rdfs:range xsd:string .

:можно_с_животными a owl:DatatypeProperty ;
    rdfs:domain :Мероприятие ;
    rdfs:range xsd:boolean .

:название a owl:DatatypeProperty ;
    rdfs:domain :Мероприятие ;
    rdfs:range xsd:string .

:описание a owl:DatatypeProperty ;
    rdfs:domain :Мероприятие ;
    rdfs:range xsd:string .

:подходитДля a owl:DatatypeProperty ;
    rdfs:domain :Мероприятие ;
    rdfs:range xsd:string .

:принимаетМероприятие a owl:ObjectProperty ;
    owl:inverseOf :проходитВ .

:размер_скидки_процент a owl:DatatypeProperty ;
    rdfs:domain :Скидка ;
    rdfs:range xsd:integer .

:сезон a owl:DatatypeProperty ;
    rdfs:domain :Мероприятие ;
    rdfs:range xsd:string .

:стоимость a owl:DatatypeProperty ;
    rdfs:comment "Базовая цена в рублях" ;
    rdfs:domain :Мероприятие ;
    rdfs:range xsd:decimal .

:тип_местности a owl:DatatypeProperty ;
    rdfs:domain :Локация ;
    rdfs:range xsd:string .

:уровень_активности a owl:DatatypeProperty ;
    rdfs:domain :Формат ;
    rdfs:range xsd:string .

:условие_скидки a owl:DatatypeProperty ;
    rdfs:domain :Скидка ;
    rdfs:range xsd:string .

:являетсяФорматДля a owl:ObjectProperty ;
    owl:inverseOf :имеетФормат .

